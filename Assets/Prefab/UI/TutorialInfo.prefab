  m_text: "\uD50C\uB808\uC774\uC5B4\uB294 \uC2DC\uC791 \uC2DC \uCE74\uB4DC 4\uC7A5\uC744
    \uBF51\uC2B5\uB2C8\uB2E4. \r\n\uAC00\uC838\uAC08 \uCE74\uB4DC\uB97C \uC120\uD0DD\uD558\uACE0
    \uB9AC\uB864\uD574\uC11C \uB2E4\uC2DC \uACE0\uB974\uAC70\uB098\n4\uC7A5 \uBAA8\uB450\uB97C
    \uC120\uD0DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\uC774\uD6C4 \uD50C\uB808\uC774\uC5B4\uB294
    \uC8FC\uC0AC\uC704\uB97C \uAD74\uB824 \uC774\uB3D9\uD560 \uB208\uAE08 \uC218\uB97C
    \uC815\uD569\uB2C8\uB2E4.\r\nM\uD0A4\uB97C \uB204\uB974\uBA74 \uC804\uB7B5 \uC9C0\uB3C4\uB85C
    \uB4E4\uC5B4\uAC00\uBA70,\n\uC804\uCCB4 \uB9F5\uC758 \uBC1C\uD310 \uC815\uBCF4\uB97C
    \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
